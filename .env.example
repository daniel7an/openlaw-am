# Generation backend — any OpenAI-compatible endpoint.
# Dev (hackathon key): OpenRouter -> deepseek/deepseek-v4-pro
# On-prem mode:        http://localhost:11434/v1 + gemma3 (Ollama)
OPENLAW_BASE_URL=https://openrouter.ai/api/v1
OPENLAW_API_KEY=sk-or-...
OPENLAW_MODEL=deepseek/deepseek-v4-pro

# Embeddings are always local (sentence-transformers), no key needed.
# D4: Armenian-tuned e5-large finetune. 1024-dim, cosine, max 512 tokens.
# ⚠️ e5 family — prefixes are mandatory: "passage: " when indexing, "query: " when searching.
OPENLAW_EMBED_MODEL=Metric-AI/armenian-text-embeddings-2-large

# Weaviate (docker-compose.yml). BYO vectors, no vectorizer module.
OPENLAW_WEAVIATE_HOST=localhost
OPENLAW_WEAVIATE_PORT=8080
